# Canonical origin for metadata, sitemap, and robots.
# Vercel fills VERCEL_PROJECT_PRODUCTION_URL in automatically as a fallback.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase public client configuration. The publishable key is safe to expose
# in the browser; never use a service-role or secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://uhqsgcwsfpqfonfdajud.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Paper submissions (app/api/submit-paper) ---

# Resend API key. Without it the submission form still renders, but the route
# answers 503 and the form points students at the email address instead.
# Free tier: https://resend.com — 3,000 emails/month.
RESEND_API_KEY=

# Sender address. Until a domain is verified in Resend, the default
# (onboarding@resend.dev) can only deliver to the Resend account owner — the
# reviewer copy arrives, the student's confirmation does not. Verify a domain
# and set this to send receipts to students.
RESEND_FROM="Apollo Labs <papers@your-domain.example>"
